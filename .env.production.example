# MongoDB Configuration
MONGO_USERNAME=admin
MONGO_PASSWORD=your-strong-mongodb-password-here

# Redis Configuration
REDIS_PASSWORD=your-strong-redis-password-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (Gmail)
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Google Cloud Storage
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_BUCKET_NAME=say2hand-uploads
GOOGLE_APPLICATION_CREDENTIALS=./config/gcs-key.json

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_URL_GCS=https://storage.googleapis.com/your-bucket-name
